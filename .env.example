# Copy to .env and fill in.
BASE_URL=https://ca-sutter.publicaccessnow.com

# Only needed if you enable the login test in tests/login.spec.ts
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional: full parcel/APN numbers without dashes for property record tests.
# Separate multiple numbers with commas or new lines. County-specific lists are
# preferred, followed by the singular county-specific value, then the shared list.
TEST_PARCEL_NUMBER=
TEST_PARCEL_NUMBER_SUTTER=028020049000
TEST_PARCEL_NUMBER_SOLANO=0176434020
TEST_PARCEL_NUMBERS=
TEST_PARCEL_NUMBERS_SUTTER=028020052000
TEST_PARCEL_NUMBERS_SOLANO=0176441030
TEST_PARCEL_NUMBER_SNOHOMISH=00437944000100
TEST_PARCEL_NUMBERS_SNOHOMISH=00401435900200

# Optional: partial street-name/address searches (for example: River, Place).
# Separate searches with commas or new lines; county-specific values are preferred.
TEST_PROPERTY_ADDRESS_SEARCHES=
TEST_PROPERTY_ADDRESS_SEARCHES_SUTTER=River
TEST_PROPERTY_ADDRESS_SEARCHES_SOLANO=Place
TEST_PROPERTY_ADDRESS_SEARCHES_SNOHOMISH=Broadway
